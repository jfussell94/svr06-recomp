mods/*
!mods/.gitkeep
out/
build/
build_*/
dist/
third_party/
PS2Recomp_*/
config/launcher_prefs.json
config/launcher_profile/
*.elf
*.iso
*.bin
*.pac
*.afs
*.irx
*.tm2
*.adx
*.sfd
*.tar.gz
*.tgz
*.zip
*.ppm
*.pgm
*.clut
*.png
*.rgba
SLES_*
SLUS_*
SCES_*
SCUS_*
SLPM_*
