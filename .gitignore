PS2Recomp/ps2xRuntime/src/runner/
overrides/sub_*.cpp
overrides/entry_*.cpp
overrides/ovl*.cpp
overrides/ovx*.cpp
overrides/*_functions.h
overrides/svr06_ovl*.cpp
overrides/svr06_ovx*.cpp
# Editor/OS
*.orig
*.bak*
.vs/
.vscode/
__pycache__/
Thumbs.db

# local secrets
config/github_token.txt

# CL-0218: game-derived VU1 microcode images and generated native code - never publish
tools/vu1bench/img/
tools/vu1bench/natlist.txt
ps2_vu1_native_gen.cpp
# CL-0271: project artwork is original work (the *.png rule above is for game-derived images)
!art/*.png
!tools/launcher/ui/icon.png
!docs/images/logo.png
# CL-0271: game-derived VU1 microcode images and the native programs generated from them - never publish
tools/vu1bench/img/
tools/vu1bench/natlist.txt
ps2_vu1_native_gen.cpp

# your own music / Titantrons / entrance choices stay on your PC
/Custom Music/**
!/Custom Music/**/
!/Custom Music/README.txt
!/Custom Music/**/.gitkeep
/Custom Titantrons/**
!/Custom Titantrons/**/
!/Custom Titantrons/README.txt
!/Custom Titantrons/**/.gitkeep
