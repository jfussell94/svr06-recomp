diff --git a/ps2xRuntime/src/lib/Kernel/Stubs/SvrConsole.cpp b/ps2xRuntime/src/lib/Kernel/Stubs/SvrConsole.cpp
new file mode 100644
index 0000000..19c304a
--- /dev/null
+++ b/ps2xRuntime/src/lib/Kernel/Stubs/SvrConsole.cpp
@@ -0,0 +1,189 @@
+// SvR06 live console: lets the developer poke the running game without rebuilding.
+// Each frame the presenter calls svr06_console_poll(); if analysis/live/cmd.txt exists its lines are executed,
+// results are appended to analysis/live/out.txt and cmd.txt is renamed to cmd_done.txt.
+#include <algorithm>
+#include <atomic>
+#include <cstdint>
+#include <cstdio>
+#include <cstdlib>
+#include <cstring>
+#include <deque>
+#include <filesystem>
+#include <fstream>
+#include <sstream>
+#include <string>
+
+std::atomic<uint8_t *> g_svr06VramPtr{nullptr};
+std::atomic<size_t> g_svr06VramSize{0};
+std::atomic<uint8_t *> g_svr06Vu1Data{nullptr};
+std::atomic<uint8_t *> g_svr06Vu1Code{nullptr};
+std::atomic<uint8_t *> g_svr06Vu0Data{nullptr};
+std::atomic<int> g_svr06CmdBtn{0};       // PS2 pad mask held by console "press"
+std::atomic<int> g_svr06CmdBtnFrames{0}; // frames left
+std::atomic<int> g_svr06Flags{0};        // free-form debug toggles (bit n via "flag n 0/1")
+std::atomic<uint64_t> g_svr06Frame{0};
+
+namespace svr06con
+{
+    struct SeqStep { int mask; int hold; int gap; };
+    std::deque<SeqStep> g_seq;
+    int g_seqPhase = 0, g_seqLeft = 0;
+
+    const char *kDir = "analysis/live/";
+
+    int btnMask(const std::string &n)
+    {
+        static const struct { const char *n; int m; } k[] = {
+            {"select", 0x0001}, {"l3", 0x0002}, {"r3", 0x0004}, {"start", 0x0008}, {"up", 0x0010}, {"right", 0x0020}, {"down", 0x0040}, {"left", 0x0080},
+            {"l2", 0x0100}, {"r2", 0x0200}, {"l1", 0x0400}, {"r1", 0x0800}, {"triangle", 0x1000}, {"circle", 0x2000}, {"cross", 0x4000}, {"square", 0x8000}};
+        for (auto &e : k)
+            if (n == e.n) return e.m;
+        return 0;
+    }
+
+    void hexdump(std::ostream &o, const uint8_t *p, uint32_t base, uint32_t len)
+    {
+        char b[8];
+        for (uint32_t i = 0; i < len; ++i)
+        {
+            if ((i & 15) == 0) { std::snprintf(b, sizeof b, "%s", ""); o << (i ? "\n" : "") << std::hex << (base + i) << ":"; }
+            std::snprintf(b, sizeof b, " %02x", p[i]);
+            o << b;
+        }
+        o << std::dec << "\n";
+    }
+}
+
+void svr06_console_poll(uint8_t *rdram)
+{
+    using namespace svr06con;
+    const uint64_t frame = ++g_svr06Frame;
+    if (g_svr06CmdBtnFrames.load() > 0 && --g_svr06CmdBtnFrames == 0)
+        g_svr06CmdBtn.store(0);
+    if (!g_seq.empty() || g_seqPhase)
+    {
+        if (g_seqPhase == 0) { g_svr06CmdBtn.store(g_seq.front().mask); g_seqLeft = g_seq.front().hold; g_seqPhase = 1; }
+        else if (--g_seqLeft <= 0)
+        {
+            if (g_seqPhase == 1) { g_svr06CmdBtn.store(0); g_seqLeft = g_seq.front().gap; g_seqPhase = 2; }
+            else { g_seq.pop_front(); g_seqPhase = 0; }
+        }
+    }
+    if ((frame % 15) != 0)
+        return;
+    const std::string cmdPath = std::string(kDir) + "cmd.txt";
+    std::error_code ec;
+    if (!std::filesystem::exists(cmdPath, ec))
+        return;
+    std::ifstream in(cmdPath);
+    std::stringstream all;
+    all << in.rdbuf();
+    in.close();
+    std::filesystem::rename(cmdPath, std::string(kDir) + "cmd_done.txt", ec);
+    if (ec) std::filesystem::remove(cmdPath, ec);
+
+    std::ofstream out(std::string(kDir) + "out.txt", std::ios::app);
+    out << "=== frame " << frame << "\n";
+    std::string line;
+    while (std::getline(all, line))
+    {
+        std::istringstream ls(line);
+        std::string c;
+        ls >> c;
+        if (c.empty() || c[0] == '#') continue;
+        out << "> " << line << "\n";
+        if (c == "ee" || c == "ee32")
+        {
+            std::string a; uint32_t len = 64; ls >> a >> len;
+            const uint32_t addr = static_cast<uint32_t>(std::strtoul(a.c_str(), nullptr, 16)) & 0x1FFFFFFu;
+            len = std::min<uint32_t>(len, 4096);
+            if (c == "ee") hexdump(out, rdram + addr, addr, std::min<uint32_t>(len, 0x2000000u - addr));
+            else { for (uint32_t i = 0; i < len && addr + i * 4 + 4 <= 0x2000000u; ++i) { uint32_t w; std::memcpy(&w, rdram + addr + i * 4, 4); out << std::hex << (addr + i * 4) << ": " << w << std::dec << "\n"; } }
+        }
+        else if (c == "poke32")
+        {
+            std::string a, v; ls >> a >> v;
+            const uint32_t addr = static_cast<uint32_t>(std::strtoul(a.c_str(), nullptr, 16)) & 0x1FFFFFCu;
+            const uint32_t val = static_cast<uint32_t>(std::strtoul(v.c_str(), nullptr, 16));
+            std::memcpy(rdram + addr, &val, 4);
+            out << "ok\n";
+        }
+        else if (c == "vram")
+        {
+            std::string a; uint32_t len = 256; ls >> a >> len;
+            uint8_t *v = g_svr06VramPtr.load();
+            const size_t vs = g_svr06VramSize.load();
+            const size_t off = static_cast<size_t>(std::strtoul(a.c_str(), nullptr, 16)) * 256u;
+            if (!v || off >= vs) out << "no vram\n";
+            else hexdump(out, v + off, static_cast<uint32_t>(off), static_cast<uint32_t>(std::min<size_t>(std::min<size_t>(len, 4096), vs - off)));
+        }
+        else if (c == "vu0d")
+        {
+            std::string a; uint32_t len = 256; ls >> a >> len;
+            uint8_t *v = g_svr06Vu0Data.load();
+            const uint32_t off = static_cast<uint32_t>(std::strtoul(a.c_str(), nullptr, 16));
+            if (!v || off >= 0x1000u) out << "no vu0 (no VIF0 unpack seen yet)\n";
+            else hexdump(out, v + off, off, std::min<uint32_t>(len, 0x1000u - off));
+        }
+        else if (c == "vu1d" || c == "vu1c")
+        {
+            std::string a; uint32_t len = 256; ls >> a >> len;
+            uint8_t *v = (c == "vu1d") ? g_svr06Vu1Data.load() : g_svr06Vu1Code.load();
+            const uint32_t sz = (c == "vu1d") ? 0x4000u : 0x4000u;
+            const uint32_t off = static_cast<uint32_t>(std::strtoul(a.c_str(), nullptr, 16));
+            if (!v || off >= sz) out << "no vu1\n";
+            else hexdump(out, v + off, off, std::min<uint32_t>(std::min<uint32_t>(len, 8192), sz - off));
+        }
+        else if (c == "vramdump" || c == "ramdump")
+        {
+            const bool isV = c == "vramdump";
+            const std::string fn = std::string(kDir) + (isV ? "live_vram.bin" : "live_ram.bin");
+            if (FILE *f = std::fopen(fn.c_str(), "wb"))
+            {
+                if (isV && g_svr06VramPtr.load()) std::fwrite(g_svr06VramPtr.load(), 1, g_svr06VramSize.load(), f);
+                if (!isV) std::fwrite(rdram, 1, 0x2000000u, f);
+                std::fclose(f);
+                out << "wrote " << fn << "\n";
+            }
+        }
+        else if (c == "press")
+        {
+            std::string b; int frames = 6; ls >> b >> frames;
+            const int m = btnMask(b);
+            g_svr06CmdBtn.store(m);
+            g_svr06CmdBtnFrames.store(frames);
+            out << (m ? "pressing " : "unknown button ") << b << " for " << frames << " frames\n";
+        }
+        else if (c == "seq")
+        {
+            std::string tok;
+            int n = 0;
+            while (ls >> tok)
+            {
+                // button:hold:gap (frames)
+                const size_t a = tok.find(':'), b = tok.find(':', a == std::string::npos ? 0 : a + 1);
+                std::string bn = tok.substr(0, a);
+                int hold = (a == std::string::npos) ? 6 : std::atoi(tok.substr(a + 1).c_str());
+                int gap = (b == std::string::npos) ? 60 : std::atoi(tok.substr(b + 1).c_str());
+                g_seq.push_back({btnMask(bn), hold, gap}); ++n;
+            }
+            out << "queued " << n << " steps\n";
+        }
+        else if (c == "flag")
+        {
+            int bit = 0, on = 1; ls >> bit >> on;
+            if (on) g_svr06Flags.fetch_or(1 << bit); else g_svr06Flags.fetch_and(~(1 << bit));
+            out << "flags=" << std::hex << g_svr06Flags.load() << std::dec << "\n";
+        }
+        else if (c == "quit")
+        {
+            out << "quitting\n"; out.flush();
+            std::_Exit(0);
+        }
+        else if (c == "frame")
+            out << "frame " << frame << "\n";
+        else
+            out << "unknown command\n";
+    }
+    out.flush();
+}
diff --git a/ps2xRuntime/src/lib/Kernel/Stubs/SvrMovie.cpp b/ps2xRuntime/src/lib/Kernel/Stubs/SvrMovie.cpp
new file mode 100644
index 0000000..007fd1c
--- /dev/null
+++ b/ps2xRuntime/src/lib/Kernel/Stubs/SvrMovie.cpp
@@ -0,0 +1,543 @@
+// Native movie player for SvR06 (Sofdec/MPEG-2 program streams stored inside AFS archives).
+// Decodes with FFmpeg on a worker thread, presents through the runtime's raylib window and plays
+// the audio track (if FFmpeg can identify one) through a raylib AudioStream.
+// Nothing here is derived from any emulator; it reads the game's own disc files.
+#include "ps2_runtime.h"
+
+#include <raylib.h>
+
+extern "C"
+{
+#include <libavcodec/avcodec.h>
+#include <libavformat/avformat.h>
+#include <libavutil/channel_layout.h>
+#include <libavutil/imgutils.h>
+#include <libavutil/log.h>
+#include <libavutil/opt.h>
+#include <libswresample/swresample.h>
+#include <libswscale/swscale.h>
+}
+
+#include <algorithm>
+#include <atomic>
+#include <chrono>
+#include <cstdint>
+#include <cstdio>
+#include <cstring>
+#include <deque>
+#include <filesystem>
+#include <fstream>
+#include <mutex>
+#include <string>
+#include <thread>
+#include <vector>
+
+namespace
+{
+    struct Src
+    {
+        std::ifstream f;
+        int64_t base = 0;
+        int64_t size = 0;
+        int64_t pos = 0;
+    };
+
+    int srcRead(void *opaque, uint8_t *buf, int bufSize)
+    {
+        Src *s = static_cast<Src *>(opaque);
+        const int64_t left = s->size - s->pos;
+        if (left <= 0)
+            return AVERROR_EOF;
+        const int n = static_cast<int>(std::min<int64_t>(left, bufSize));
+        s->f.clear();
+        s->f.seekg(s->base + s->pos, std::ios::beg);
+        s->f.read(reinterpret_cast<char *>(buf), n);
+        const int got = static_cast<int>(s->f.gcount());
+        if (got <= 0)
+            return AVERROR_EOF;
+        s->pos += got;
+        return got;
+    }
+
+    int64_t srcSeek(void *opaque, int64_t offset, int whence)
+    {
+        Src *s = static_cast<Src *>(opaque);
+        if (whence & AVSEEK_SIZE)
+            return s->size;
+        whence &= ~AVSEEK_FORCE;
+        int64_t np = s->pos;
+        if (whence == SEEK_SET)
+            np = offset;
+        else if (whence == SEEK_CUR)
+            np = s->pos + offset;
+        else if (whence == SEEK_END)
+            np = s->size + offset;
+        else
+            return -1;
+        if (np < 0 || np > s->size)
+            return -1;
+        s->pos = np;
+        return np;
+    }
+
+    struct Movie
+    {
+        std::atomic<bool> running{false};
+        std::atomic<bool> done{false};
+        std::atomic<bool> acked{true};
+        std::atomic<bool> abort{false};
+        std::thread th;
+
+        std::mutex vm;
+        std::vector<uint8_t> frame;
+        int fw = 0, fh = 0;
+        bool fresh = false;
+        bool anyFrame = false;
+
+        std::mutex am;
+        std::deque<int16_t> pcm;
+    };
+
+    Movie g;
+
+    constexpr int kAudioRate = 48000;
+    constexpr size_t kPcmCap = kAudioRate * 2 * 1; // ~1 second of stereo s16
+
+    bool sleepUntil(std::chrono::steady_clock::time_point t)
+    {
+        while (std::chrono::steady_clock::now() < t)
+        {
+            if (g.abort.load())
+                return false;
+            const auto left = t - std::chrono::steady_clock::now();
+            std::this_thread::sleep_for(std::min<std::chrono::steady_clock::duration>(left, std::chrono::milliseconds(5)));
+        }
+        return !g.abort.load();
+    }
+
+    void runMovieImpl(const std::string &path, int entry, bool loopMovie, bool &again)
+    {
+        auto finish = [&]()
+        {
+            g.running.store(false);
+            g.done.store(true);
+        };
+
+        Src src;
+        src.f.open(path, std::ios::binary);
+        if (!src.f)
+        {
+            std::fprintf(stderr, "[movie] cannot open %s\n", path.c_str());
+            finish();
+            return;
+        }
+        uint8_t head[8];
+        src.f.read(reinterpret_cast<char *>(head), 8);
+        uint32_t count = 0;
+        std::memcpy(&count, head + 4, 4);
+        if (std::memcmp(head, "AFS\0", 4) != 0 || entry < 0 || static_cast<uint32_t>(entry) >= count)
+        {
+            std::fprintf(stderr, "[movie] bad AFS or entry %d (count=%u) in %s\n", entry, count, path.c_str());
+            finish();
+            return;
+        }
+        uint32_t ent[2] = {0, 0};
+        src.f.seekg(8 + static_cast<std::streamoff>(entry) * 8, std::ios::beg);
+        src.f.read(reinterpret_cast<char *>(ent), 8);
+        src.base = ent[0];
+        src.size = ent[1];
+        src.pos = 0;
+        std::fprintf(stderr, "[movie] playing %s entry %d offset=0x%x size=%u\n", path.c_str(), entry, ent[0], ent[1]);
+
+        const int ioSize = 1 << 16;
+        uint8_t *ioBuf = static_cast<uint8_t *>(av_malloc(ioSize));
+        AVIOContext *io = avio_alloc_context(ioBuf, ioSize, 0, &src, srcRead, nullptr, srcSeek);
+        AVFormatContext *fc = avformat_alloc_context();
+        fc->pb = io;
+        fc->flags |= AVFMT_FLAG_CUSTOM_IO;
+        av_log_set_level(AV_LOG_ERROR);
+        if (avformat_open_input(&fc, nullptr, nullptr, nullptr) < 0)
+        {
+            std::fprintf(stderr, "[movie] avformat_open_input failed\n");
+            av_freep(&io->buffer);
+            avio_context_free(&io);
+            finish();
+            return;
+        }
+        avformat_find_stream_info(fc, nullptr);
+
+        int vIdx = -1, aIdx = -1;
+        for (unsigned i = 0; i < fc->nb_streams; ++i)
+        {
+            const AVCodecParameters *p = fc->streams[i]->codecpar;
+            std::fprintf(stderr, "[movie] stream %u type=%d codec=%s %dx%d\n", i, static_cast<int>(p->codec_type), avcodec_get_name(p->codec_id), p->width, p->height);
+            if (p->codec_type == AVMEDIA_TYPE_VIDEO && vIdx < 0)
+                vIdx = static_cast<int>(i);
+            else if (p->codec_type == AVMEDIA_TYPE_AUDIO && aIdx < 0)
+                aIdx = static_cast<int>(i);
+        }
+        AVCodecContext *vctx = nullptr, *actx = nullptr;
+        SwsContext *sws = nullptr;
+        SwrContext *swr = nullptr;
+        if (vIdx >= 0)
+        {
+            const AVCodec *c = avcodec_find_decoder(fc->streams[vIdx]->codecpar->codec_id);
+            vctx = avcodec_alloc_context3(c);
+            avcodec_parameters_to_context(vctx, fc->streams[vIdx]->codecpar);
+            if (avcodec_open2(vctx, c, nullptr) < 0)
+            {
+                avcodec_free_context(&vctx);
+                vIdx = -1;
+            }
+        }
+        if (aIdx >= 0)
+        {
+            const AVCodec *c = avcodec_find_decoder(fc->streams[aIdx]->codecpar->codec_id);
+            if (c)
+            {
+                actx = avcodec_alloc_context3(c);
+                avcodec_parameters_to_context(actx, fc->streams[aIdx]->codecpar);
+                if (avcodec_open2(actx, c, nullptr) < 0)
+                    avcodec_free_context(&actx);
+            }
+            if (!actx)
+                aIdx = -1;
+        }
+
+        AVPacket *pkt = av_packet_alloc();
+        AVFrame *fr = av_frame_alloc();
+        AVFrame *afr = av_frame_alloc();
+        std::vector<uint8_t> rgba;
+        bool haveStart = false;
+        std::chrono::steady_clock::time_point startWall;
+        double firstPts = 0.0;
+        int frames = 0;
+
+        for (;;)
+        {
+        if (g.abort.load()) break;
+        if (av_read_frame(fc, pkt) < 0)
+        {
+            break;
+        }
+            if (pkt->stream_index == vIdx && vctx)
+            {
+                if (avcodec_send_packet(vctx, pkt) >= 0)
+                {
+                    while (avcodec_receive_frame(vctx, fr) >= 0)
+                    {
+                        const int w = fr->width, h = fr->height;
+                        sws = sws_getCachedContext(sws, w, h, static_cast<AVPixelFormat>(fr->format), w, h, AV_PIX_FMT_RGBA, SWS_BILINEAR, nullptr, nullptr, nullptr);
+                        rgba.resize(static_cast<size_t>(w) * h * 4);
+                        uint8_t *dst[1] = {rgba.data()};
+                        int dstStride[1] = {w * 4};
+                        sws_scale(sws, fr->data, fr->linesize, 0, h, dst, dstStride);
+
+                        const AVRational tb = fc->streams[vIdx]->time_base;
+                        const int64_t ts = fr->best_effort_timestamp;
+                        if (ts != AV_NOPTS_VALUE)
+                        {
+                            const double sec = ts * av_q2d(tb);
+                            if (!haveStart)
+                            {
+                                haveStart = true;
+                                firstPts = sec;
+                                startWall = std::chrono::steady_clock::now();
+                            }
+                            const auto due = startWall + std::chrono::microseconds(static_cast<int64_t>((sec - firstPts) * 1e6));
+                            if (!sleepUntil(due))
+                                break;
+                        }
+                        {
+                            std::lock_guard<std::mutex> lk(g.vm);
+                            g.frame = rgba;
+                            g.fw = w;
+                            g.fh = h;
+                            g.fresh = true;
+                            g.anyFrame = true;
+                        }
+                        ++frames;
+                        if ((frames % 30) == 1) std::fprintf(stderr, "[movie] frame %d pts=%.2f src=%lld/%lld\n", frames, ts == AV_NOPTS_VALUE ? -1.0 : ts * av_q2d(tb), (long long)src.pos, (long long)src.size);
+                    }
+                }
+            }
+            else if (pkt->stream_index == aIdx && actx)
+            {
+                if (avcodec_send_packet(actx, pkt) >= 0)
+                {
+                    while (avcodec_receive_frame(actx, afr) >= 0)
+                    {
+                        if (!swr)
+                        {
+                            AVChannelLayout out;
+                            av_channel_layout_default(&out, 2);
+                            swr_alloc_set_opts2(&swr, &out, AV_SAMPLE_FMT_S16, kAudioRate, &afr->ch_layout, static_cast<AVSampleFormat>(afr->format), afr->sample_rate, 0, nullptr);
+                            swr_init(swr);
+                        }
+                        const int maxOut = swr_get_out_samples(swr, afr->nb_samples) + 64;
+                        std::vector<int16_t> out(static_cast<size_t>(maxOut) * 2);
+                        uint8_t *op[1] = {reinterpret_cast<uint8_t *>(out.data())};
+                        const int n = swr_convert(swr, op, maxOut, const_cast<const uint8_t **>(afr->extended_data), afr->nb_samples);
+                        if (n > 0)
+                        {
+                            for (int tries = 0; !g.abort.load() && tries < 40; ++tries)
+                            {
+                                {
+                                    std::lock_guard<std::mutex> lk(g.am);
+                                    if (g.pcm.size() < kPcmCap)
+                                    {
+                                        g.pcm.insert(g.pcm.end(), out.begin(), out.begin() + static_cast<size_t>(n) * 2);
+                                        break;
+                                    }
+                                }
+                                std::this_thread::sleep_for(std::chrono::milliseconds(5));
+                            }
+                        }
+                    }
+                }
+            }
+            av_packet_unref(pkt);
+        }
+        // flush video
+        if (vctx && !g.abort.load())
+        {
+            avcodec_send_packet(vctx, nullptr);
+            while (avcodec_receive_frame(vctx, fr) >= 0 && !g.abort.load())
+            {
+                const int w = fr->width, h = fr->height;
+                sws = sws_getCachedContext(sws, w, h, static_cast<AVPixelFormat>(fr->format), w, h, AV_PIX_FMT_RGBA, SWS_BILINEAR, nullptr, nullptr, nullptr);
+                rgba.resize(static_cast<size_t>(w) * h * 4);
+                uint8_t *dst[1] = {rgba.data()};
+                int dstStride[1] = {w * 4};
+                sws_scale(sws, fr->data, fr->linesize, 0, h, dst, dstStride);
+                std::this_thread::sleep_for(std::chrono::milliseconds(33));
+                std::lock_guard<std::mutex> lk(g.vm);
+                g.frame = rgba;
+                g.fw = w;
+                g.fh = h;
+                g.fresh = true;
+            }
+        }
+        // let the audio queue drain
+        if (!g.abort.load())
+        {
+            for (int i = 0; i < 200 && !g.abort.load(); ++i)
+            {
+                {
+                    std::lock_guard<std::mutex> lk(g.am);
+                    if (g.pcm.empty())
+                        break;
+                }
+                std::this_thread::sleep_for(std::chrono::milliseconds(10));
+            }
+        }
+        std::fprintf(stderr, "[movie] finished (%d frames)\n", frames);
+        av_frame_free(&fr);
+        av_frame_free(&afr);
+        av_packet_free(&pkt);
+        if (sws)
+            sws_freeContext(sws);
+        if (swr)
+            swr_free(&swr);
+        if (vctx)
+            avcodec_free_context(&vctx);
+        if (actx)
+            avcodec_free_context(&actx);
+        avformat_close_input(&fc);
+        av_freep(&io->buffer);
+        avio_context_free(&io);
+        if (loopMovie && !g.abort.load()) { again = true; return; }
+        finish();
+    }
+
+    void runMovie(std::string path, int entry, bool loopMovie)
+    {
+        bool again = false;
+        do
+        {
+            again = false;
+            runMovieImpl(path, entry, loopMovie, again);
+        } while (again && !g.abort.load());
+    }
+
+    // presenter-side state (main thread only)
+    Texture2D s_tex{};
+    int s_texW = 0, s_texH = 0;
+    AudioStream s_as{};
+    bool s_asInit = false;
+    bool s_asPlaying = false;
+}
+
+namespace { std::atomic<bool> g_hold{false}; bool s_holdPrevBtn = true; float s_holdMax = 0.0f; int s_holdDark = 0; }
+std::atomic<float> g_svr06FrameLum{0.0f};
+bool svr06_music_stop(uint32_t);
+
+// ---- public API (plain C++ linkage; declared by hand in callers) ----
+void svr06_movie_hold()
+{
+    g_hold.store(true); s_holdPrevBtn = true; s_holdMax = 0.0f; s_holdDark = 0;
+    std::fprintf(stderr, "[movie] holding last frame behind game screen\n");
+}
+bool svr06_movie_holding() { return g_hold.load(); }
+
+void svr06_movie_stop()
+{
+    g.abort.store(true);
+    if (g.th.joinable())
+        g.th.join();
+    g.abort.store(false);
+    g.running.store(false);
+    g.done.store(false);
+    g.acked.store(true);
+    {
+        std::lock_guard<std::mutex> lk(g.vm);
+        g.fresh = false;
+        g.anyFrame = false;
+    }
+    {
+        std::lock_guard<std::mutex> lk(g.am);
+        g.pcm.clear();
+    }
+}
+
+bool svr06_movie_start(const char *afsRelPath, int entry, bool loop)
+{
+    svr06_movie_stop();
+    g_hold.store(false);
+    const PS2Runtime::IoPaths &paths = PS2Runtime::getIoPaths();
+    std::filesystem::path root = paths.cdRoot;
+    std::filesystem::path p = root / afsRelPath;
+    std::error_code ec;
+    if (!std::filesystem::exists(p, ec))
+    {
+        std::fprintf(stderr, "[movie] missing file %s\n", p.string().c_str());
+        return false;
+    }
+    g.done.store(false);
+    g.acked.store(false);
+    g.running.store(true);
+    g.th = std::thread(runMovie, p.string(), entry, loop);
+    return true;
+}
+
+bool svr06_movie_active()
+{
+    return g.running.load() || (g.done.load() && !g.acked.load());
+}
+
+bool svr06_movie_done()
+{
+    return g.done.load();
+}
+
+void svr06_movie_ack()
+{
+    g.acked.store(true);
+}
+
+bool svr06_movie_skip_requested()
+{
+    for (int gi = 0; gi < 4; ++gi)
+        if (IsGamepadAvailable(gi) && (IsGamepadButtonDown(gi, GAMEPAD_BUTTON_MIDDLE_RIGHT) || IsGamepadButtonDown(gi, GAMEPAD_BUTTON_RIGHT_FACE_DOWN)))
+            return true;
+    return IsKeyDown(KEY_ENTER) || IsKeyDown(KEY_SPACE) || IsKeyDown(KEY_KP_ENTER);
+}
+
+// Called by the presenter between BeginDrawing/EndDrawing. Returns true if the movie frame was drawn.
+bool svr06_movie_present(float dx, float dy, float dw, float dh)
+{
+    const bool active = svr06_movie_active();
+    if (!active)
+    {
+        if (s_asPlaying)
+        {
+            StopAudioStream(s_as);
+            s_asPlaying = false;
+        }
+        if (g_hold.load() && s_tex.id != 0)
+        {
+            // title: keep the final picture under the game's own PRESS START layer, fading along with it
+            const float lum = g_svr06FrameLum.load();
+            if (lum > s_holdMax) s_holdMax = lum;
+            const bool btn = svr06_movie_skip_requested();
+            const bool edge = btn && !s_holdPrevBtn; s_holdPrevBtn = btn;
+            if (s_holdMax > 0.0f && lum <= 0.0f) ++s_holdDark; else s_holdDark = 0;
+            if (edge || s_holdDark > 8)
+            {
+                g_hold.store(false);
+                svr06_music_stop(0xFFFF0001u);
+                std::fprintf(stderr, "[movie] hold released (%s)\n", edge ? "button" : "faded out");
+                return false;
+            }
+            const float k = s_holdMax > 0.0f ? std::min(1.0f, lum / s_holdMax) : 1.0f;
+            const unsigned char c = static_cast<unsigned char>(255.0f * k);
+            ClearBackground(BLACK);
+            const Rectangle src{0.0f, 0.0f, static_cast<float>(s_texW), static_cast<float>(s_texH)};
+            DrawTexturePro(s_tex, src, Rectangle{dx, dy, dw, dh}, Vector2{0.0f, 0.0f}, 0.0f, Color{c, c, c, 255});
+            return true;
+        }
+        return false;
+    }
+
+    // upload newest frame
+    {
+        std::lock_guard<std::mutex> lk(g.vm);
+        if (g.fresh && g.fw > 0 && g.fh > 0)
+        {
+            if (s_tex.id == 0 || s_texW != g.fw || s_texH != g.fh)
+            {
+                if (s_tex.id != 0)
+                    UnloadTexture(s_tex);
+                Image img = GenImageColor(g.fw, g.fh, BLACK);
+                ImageFormat(&img, PIXELFORMAT_UNCOMPRESSED_R8G8B8A8);
+                s_tex = LoadTextureFromImage(img);
+                UnloadImage(img);
+                s_texW = g.fw;
+                s_texH = g.fh;
+            }
+            UpdateTexture(s_tex, g.frame.data());
+            g.fresh = false;
+        }
+    }
+
+    // audio
+    if (IsAudioDeviceReady())
+    {
+        if (!s_asInit)
+        {
+            SetAudioStreamBufferSizeDefault(2048);
+            s_as = LoadAudioStream(kAudioRate, 16, 2);
+            s_asInit = true;
+        }
+        if (!s_asPlaying)
+        {
+            PlayAudioStream(s_as);
+            s_asPlaying = true;
+        }
+        int guard = 0;
+        while (IsAudioStreamProcessed(s_as) && guard++ < 4)
+        {
+            int16_t buf[2048 * 2];
+            std::memset(buf, 0, sizeof(buf));
+            {
+                std::lock_guard<std::mutex> lk(g.am);
+                const size_t n = std::min<size_t>(g.pcm.size(), 2048 * 2);
+                for (size_t i = 0; i < n; ++i)
+                    buf[i] = g.pcm[i];
+                g.pcm.erase(g.pcm.begin(), g.pcm.begin() + static_cast<std::ptrdiff_t>(n));
+            }
+            UpdateAudioStream(s_as, buf, 2048);
+        }
+    }
+
+    ClearBackground(BLACK);
+    if (s_tex.id != 0)
+    {
+        // the PS2 shows the 640x448 picture at the TV aspect: fill the destination rectangle
+        const float w = dw, h = dh;
+        const Rectangle src{0.0f, 0.0f, static_cast<float>(s_texW), static_cast<float>(s_texH)};
+        const Rectangle dst{dx + (dw - w) * 0.5f, dy + (dh - h) * 0.5f, w, h};
+        DrawTexturePro(s_tex, src, dst, Vector2{0.0f, 0.0f}, 0.0f, WHITE);
+    }
+    return true;
+}
diff --git a/ps2xRuntime/src/lib/Kernel/Stubs/SvrMusic.cpp b/ps2xRuntime/src/lib/Kernel/Stubs/SvrMusic.cpp
new file mode 100644
index 0000000..6472475
--- /dev/null
+++ b/ps2xRuntime/src/lib/Kernel/Stubs/SvrMusic.cpp
@@ -0,0 +1,341 @@
+// Native ADX music player for SvR06. The game's CRI ADXT layer (ADXT_StartAfs etc.) normally streams ADX files from
+// the BGM*.AFS archives through the IOP; here the hooks in svr06_overrides.cpp hand those requests to this player,
+// which reads the ADX entry straight from the disc files, decodes it with FFmpeg and plays it through raylib.
+#include "ps2_runtime.h"
+
+#include <raylib.h>
+
+extern "C"
+{
+#include <libavcodec/avcodec.h>
+#include <libavformat/avformat.h>
+#include <libavutil/channel_layout.h>
+#include <libavutil/log.h>
+#include <libswresample/swresample.h>
+}
+
+#include <algorithm>
+#include <atomic>
+#include <chrono>
+#include <cmath>
+#include <cstdint>
+#include <cstdio>
+#include <cstring>
+#include <deque>
+#include <filesystem>
+#include <fstream>
+#include <mutex>
+#include <string>
+#include <thread>
+#include <vector>
+
+namespace
+{
+    struct Src
+    {
+        std::ifstream f;
+        int64_t base = 0, size = 0, pos = 0;
+    };
+
+    int srcRead(void *o, uint8_t *buf, int n)
+    {
+        Src *s = static_cast<Src *>(o);
+        const int64_t left = s->size - s->pos;
+        if (left <= 0)
+            return AVERROR_EOF;
+        const int want = static_cast<int>(std::min<int64_t>(left, n));
+        s->f.clear();
+        s->f.seekg(s->base + s->pos, std::ios::beg);
+        s->f.read(reinterpret_cast<char *>(buf), want);
+        const int got = static_cast<int>(s->f.gcount());
+        if (got <= 0)
+            return AVERROR_EOF;
+        s->pos += got;
+        return got;
+    }
+
+    int64_t srcSeek(void *o, int64_t off, int whence)
+    {
+        Src *s = static_cast<Src *>(o);
+        if (whence & AVSEEK_SIZE)
+            return s->size;
+        whence &= ~AVSEEK_FORCE;
+        int64_t np = s->pos;
+        if (whence == SEEK_SET) np = off;
+        else if (whence == SEEK_CUR) np = s->pos + off;
+        else if (whence == SEEK_END) np = s->size + off;
+        else return -1;
+        if (np < 0 || np > s->size)
+            return -1;
+        s->pos = np;
+        return np;
+    }
+
+    constexpr int kRate = 48000;
+    constexpr size_t kRingCap = kRate * 2 * 2; // 2 s of stereo s16
+    constexpr int kSlots = 6;
+
+    struct Slot
+    {
+        std::atomic<uint32_t> handle{0};
+        std::atomic<bool> active{false};
+        std::atomic<bool> abort{false};
+        std::atomic<bool> ended{false};
+        std::atomic<bool> started{false};
+        std::atomic<float> gain{1.0f};
+        std::thread th;
+        std::mutex m;
+        std::deque<int16_t> ring;
+        AudioStream as{};
+        bool asOpen = false;
+    };
+    Slot g_slots[kSlots];
+    std::mutex g_mtx;
+
+    template <int I>
+    void audioCb(void *buffer, unsigned int frames)
+    {
+        Slot &s = g_slots[I];
+        int16_t *out = static_cast<int16_t *>(buffer);
+        const float gain = s.gain.load();
+        std::lock_guard<std::mutex> lk(s.m);
+        const size_t want = static_cast<size_t>(frames) * 2;
+        const size_t n = std::min(want, s.ring.size());
+        for (size_t i = 0; i < n; ++i)
+            out[i] = static_cast<int16_t>(std::clamp(static_cast<int>(s.ring[i] * gain), -32768, 32767));
+        for (size_t i = n; i < want; ++i)
+            out[i] = 0;
+        s.ring.erase(s.ring.begin(), s.ring.begin() + static_cast<std::ptrdiff_t>(n));
+    }
+
+    typedef void (*Cb)(void *, unsigned int);
+    const Cb kCbs[kSlots] = {audioCb<0>, audioCb<1>, audioCb<2>, audioCb<3>, audioCb<4>, audioCb<5>};
+
+    void decodeOnce(Slot *s, const std::string &path, int entry, bool loop)
+    {
+        Src src;
+        src.f.open(path, std::ios::binary);
+        uint8_t head[8] = {};
+        uint32_t count = 0, ent[2] = {0, 0};
+        if (src.f)
+        {
+            src.f.read(reinterpret_cast<char *>(head), 8);
+            std::memcpy(&count, head + 4, 4);
+        }
+        if (!src.f || std::memcmp(head, "AFS\0", 4) != 0 || entry < 0 || static_cast<uint32_t>(entry) >= count)
+        {
+            std::fprintf(stderr, "[music] bad AFS/entry %d in %s\n", entry, path.c_str());
+            s->ended.store(true);
+            return;
+        }
+        src.f.seekg(8 + static_cast<std::streamoff>(entry) * 8, std::ios::beg);
+        src.f.read(reinterpret_cast<char *>(ent), 8);
+        src.base = ent[0];
+        src.size = ent[1];
+
+        const int ioSize = 1 << 16;
+        uint8_t *ioBuf = static_cast<uint8_t *>(av_malloc(ioSize));
+        AVIOContext *io = avio_alloc_context(ioBuf, ioSize, 0, &src, srcRead, nullptr, srcSeek);
+        AVFormatContext *fc = avformat_alloc_context();
+        fc->pb = io;
+        fc->flags |= AVFMT_FLAG_CUSTOM_IO;
+        av_log_set_level(AV_LOG_ERROR);
+        if (avformat_open_input(&fc, nullptr, nullptr, nullptr) < 0 || avformat_find_stream_info(fc, nullptr) < 0)
+        {
+            std::fprintf(stderr, "[music] open failed %s entry %d\n", path.c_str(), entry);
+            av_freep(&io->buffer);
+            avio_context_free(&io);
+            s->ended.store(true);
+            return;
+        }
+        int aIdx = -1;
+        for (unsigned i = 0; i < fc->nb_streams; ++i)
+            if (fc->streams[i]->codecpar->codec_type == AVMEDIA_TYPE_AUDIO) { aIdx = static_cast<int>(i); break; }
+        const AVCodec *codec = aIdx >= 0 ? avcodec_find_decoder(fc->streams[aIdx]->codecpar->codec_id) : nullptr;
+        AVCodecContext *ctx = codec ? avcodec_alloc_context3(codec) : nullptr;
+        if (!ctx || avcodec_parameters_to_context(ctx, fc->streams[aIdx]->codecpar) < 0 || avcodec_open2(ctx, codec, nullptr) < 0)
+        {
+            std::fprintf(stderr, "[music] no audio decoder\n");
+            if (ctx) avcodec_free_context(&ctx);
+            avformat_close_input(&fc);
+            av_freep(&io->buffer);
+            avio_context_free(&io);
+            s->ended.store(true);
+            return;
+        }
+        std::fprintf(stderr, "[music] decoding %s entry %d (%s %d Hz %d ch) loop=%d\n", path.c_str(), entry, avcodec_get_name(ctx->codec_id), ctx->sample_rate, ctx->ch_layout.nb_channels, loop ? 1 : 0);
+
+        AVPacket *pkt = av_packet_alloc();
+        AVFrame *fr = av_frame_alloc();
+        SwrContext *swr = nullptr;
+        bool eof = false;
+        while (!s->abort.load())
+        {
+            {
+                std::lock_guard<std::mutex> lk(s->m);
+                if (s->ring.size() >= kRingCap)
+                {
+                    // fall through to sleep below
+                }
+                else
+                {
+                    goto produce;
+                }
+            }
+            std::this_thread::sleep_for(std::chrono::milliseconds(10));
+            continue;
+        produce:
+            if (eof)
+            {
+                if (loop)
+                    break; // the wrapper reopens the file
+                // wait for the ring to drain, then report the end
+                for (int i = 0; i < 400 && !s->abort.load(); ++i)
+                {
+                    {
+                        std::lock_guard<std::mutex> lk(s->m);
+                        if (s->ring.empty()) break;
+                    }
+                    std::this_thread::sleep_for(std::chrono::milliseconds(10));
+                }
+                s->ended.store(true);
+                break;
+            }
+            if (av_read_frame(fc, pkt) < 0)
+            {
+                eof = true;
+                continue;
+            }
+            if (pkt->stream_index == aIdx && avcodec_send_packet(ctx, pkt) >= 0)
+            {
+                while (avcodec_receive_frame(ctx, fr) >= 0)
+                {
+                    if (!swr)
+                    {
+                        AVChannelLayout out;
+                        av_channel_layout_default(&out, 2);
+                        swr_alloc_set_opts2(&swr, &out, AV_SAMPLE_FMT_S16, kRate, &fr->ch_layout, static_cast<AVSampleFormat>(fr->format), fr->sample_rate, 0, nullptr);
+                        swr_init(swr);
+                    }
+                    const int maxOut = swr_get_out_samples(swr, fr->nb_samples) + 64;
+                    std::vector<int16_t> buf(static_cast<size_t>(maxOut) * 2);
+                    uint8_t *op[1] = {reinterpret_cast<uint8_t *>(buf.data())};
+                    const int n = swr_convert(swr, op, maxOut, const_cast<const uint8_t **>(fr->extended_data), fr->nb_samples);
+                    if (n > 0)
+                    {
+                        std::lock_guard<std::mutex> lk(s->m);
+                        s->ring.insert(s->ring.end(), buf.begin(), buf.begin() + static_cast<size_t>(n) * 2);
+                    }
+                }
+            }
+            av_packet_unref(pkt);
+        }
+        av_frame_free(&fr);
+        av_packet_free(&pkt);
+        if (swr) swr_free(&swr);
+        avcodec_free_context(&ctx);
+        avformat_close_input(&fc);
+        av_freep(&io->buffer);
+        avio_context_free(&io);
+    }
+
+    void decodeLoop(Slot *s, std::string path, int entry, bool loop)
+    {
+        do
+        {
+            decodeOnce(s, path, entry, loop);
+        } while (loop && !s->abort.load() && !s->ended.load());
+    }
+
+    void closeSlot(Slot &s)
+    {
+        s.abort.store(true);
+        if (s.th.joinable())
+            s.th.join();
+        if (s.asOpen)
+        {
+            StopAudioStream(s.as);
+            UnloadAudioStream(s.as);
+            s.asOpen = false;
+        }
+        {
+            std::lock_guard<std::mutex> lk(s.m);
+            s.ring.clear();
+        }
+        s.abort.store(false);
+        s.active.store(false);
+        s.ended.store(false);
+        s.started.store(false);
+        s.handle.store(0);
+    }
+
+    Slot *find(uint32_t handle)
+    {
+        for (auto &s : g_slots)
+            if (s.active.load() && s.handle.load() == handle)
+                return &s;
+        return nullptr;
+    }
+}
+
+bool svr06_music_start(uint32_t handle, const char *rel, int entry, bool loop)
+{
+    std::lock_guard<std::mutex> lk(g_mtx);
+    if (Slot *old = find(handle))
+        closeSlot(*old);
+    Slot *s = nullptr;
+    for (auto &c : g_slots)
+        if (!c.active.load()) { s = &c; break; }
+    if (!s)
+        return false;
+    const PS2Runtime::IoPaths &paths = PS2Runtime::getIoPaths();
+    const std::filesystem::path p = paths.cdRoot / rel;
+    std::error_code ec;
+    if (!std::filesystem::exists(p, ec))
+    {
+        std::fprintf(stderr, "[music] missing %s\n", p.string().c_str());
+        return false;
+    }
+    const int idx = static_cast<int>(s - g_slots);
+    s->handle.store(handle);
+    s->active.store(true);
+    s->gain.store(1.0f);
+    if (IsAudioDeviceReady())
+    {
+        s->as = LoadAudioStream(kRate, 16, 2);
+        SetAudioStreamCallback(s->as, kCbs[idx]);
+        PlayAudioStream(s->as);
+        s->asOpen = true;
+    }
+    s->th = std::thread(decodeLoop, s, p.string(), entry, loop);
+    s->started.store(true);
+    return true;
+}
+
+// ADXT status: 0 STOP, 3 PLAYING, 5 PLAYEND. Returns -1 if the handle is not ours.
+int svr06_music_stat(uint32_t handle)
+{
+    Slot *s = find(handle);
+    if (!s)
+        return -1;
+    return s->ended.load() ? 5 : 3;
+}
+
+bool svr06_music_stop(uint32_t handle)
+{
+    std::lock_guard<std::mutex> lk(g_mtx);
+    Slot *s = find(handle);
+    if (!s)
+        return false;
+    closeSlot(*s);
+    return true;
+}
+
+void svr06_music_volume(uint32_t handle, int32_t vol)
+{
+    Slot *s = find(handle);
+    if (!s)
+        return;
+    // CRI ADXT volume: 0 = full, negative in 1/10 dB (-960 = silence)
+    s->gain.store(vol <= -960 ? 0.0f : std::pow(10.0f, static_cast<float>(std::min(vol, 0)) / 200.0f));
+}
diff --git a/ps2xRuntime/src/lib/Kernel/Syscalls/Dispatcher.cpp b/ps2xRuntime/src/lib/Kernel/Syscalls/Dispatcher.cpp
index 121fcc7..93e3749 100644
--- a/ps2xRuntime/src/lib/Kernel/Syscalls/Dispatcher.cpp
+++ b/ps2xRuntime/src/lib/Kernel/Syscalls/Dispatcher.cpp
@@ -1,6 +1,9 @@
 #include "Common.h"
 #include "Dispatcher.h"
 #include "System.h"
+#include <atomic>
+#include <cstdio>
+#include "runtime/ee_scheduler.h"
 
 namespace ps2_syscalls
 {
@@ -11,6 +14,23 @@ namespace ps2_syscalls
             return true;
